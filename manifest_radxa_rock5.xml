<?xml version="1.0" encoding="UTF-8"?>
<!--
  Open AOSP 15 port for the Radxa ROCK 5 family (mainline kernel, Mesa PanVK).
  Base: https://android.googlesource.com/platform/manifest, android-15.0.0_r32
-->
<manifest>
  <remote name="radicales" fetch="https://github.com/RadicalES/" />

  <!-- Device tree: board config, ramdisk, HALs, kernel/U-Boot/image scripts -->
  <project path="device/radxa/rock5" name="android_device_radxa_rock5" remote="radicales" revision="main" />

  <!-- Prebuilt mainline kernel (Image, DTBs) and U-Boot, built by the device
       tree's kernel/ and bootloader/ scripts -->
  <project path="device/radxa/rock5-kernel" name="android_device_radxa_rock5-kernel" remote="radicales" revision="android-15-rock5" clone-depth="1" />

  <!-- Mesa PanVK (Vulkan for Mali-G610) with a Soong build generated by
       ninja-to-soong. The path is the one ninja-to-soong generates for. -->
  <project path="vendor/google/graphics/desktop/mesa3d/panvk" name="mesa" remote="radicales" revision="android-15-rock5" clone-depth="1" />

  <!-- minigbm gralloc: drops DRM master after opening the display node, so
       drm_hwcomposer can take the display (RK3588's render node is panthor,
       which minigbm has no backend for) -->
  <remove-project name="platform/external/minigbm" />
  <project path="external/minigbm" name="minigbm" remote="radicales" revision="android-15-rock5" />
</manifest>
