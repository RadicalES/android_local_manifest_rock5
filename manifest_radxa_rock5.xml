<?xml version="1.0" encoding="UTF-8"?>
<!--
  Open AOSP 15 port for the Radxa ROCK 5 family (mainline kernel, Mesa PanVK).
  Base: https://android.googlesource.com/platform/manifest, android-15.0.0_r32
-->
<manifest>
  <remote name="radicales" fetch="https://github.com/RadicalES/" />

  <!-- Device tree: board config, ramdisk, HALs, kernel/U-Boot/image scripts -->
  <project path="device/radxa/rock5" name="android_device_radxa_rock5" remote="radicales" revision="main" />

  <!-- Prebuilt mainline kernel (Image, DTBs) and U-Boot, built by the device
       tree's kernel/ and bootloader/ scripts -->
  <project path="device/radxa/rock5-kernel" name="android_device_radxa_rock5-kernel" remote="radicales" revision="android-15-rock5" clone-depth="1" />

  <!-- Mesa PanVK (Vulkan for Mali-G610) with a Soong build generated by
       ninja-to-soong. The path is the one ninja-to-soong generates for. -->
  <project path="vendor/google/graphics/desktop/mesa3d/panvk" name="android_external_mesa" remote="radicales" revision="android-15-rock5" clone-depth="1" />

  <!-- minigbm gralloc: drops DRM master after opening the display node, so
       drm_hwcomposer can take the display (RK3588's render node is panthor,
       which minigbm has no backend for) -->
  <remove-project name="platform/external/minigbm" />
  <project path="external/minigbm" name="android_external_minigbm" remote="radicales" revision="android-15-rock5" />

  <!-- hardware/interfaces: the AIDL default Bluetooth HAL with its rfkill
       handling fixed (unblock on open as in AOSP main; use the hci device's
       rfkill, not the board's rfkill-gpio enable line) -->
  <remove-project name="platform/hardware/interfaces" />
  <project path="hardware/interfaces" name="android_hardware_interfaces" remote="radicales" revision="android-15.0" />

  <!-- hardware/radicales: board-neutral vendor HALs (DDC/CI monitor brightness) -->
  <project path="hardware/radicales" name="android_hardware_radicales" remote="radicales" revision="main" />

  <!-- packages/apps/Settings: Ethernet IP configuration and NTP, network adb,
       fixed screen orientation and keep screen on; no crashes without Wi-Fi;
       config_show_ethernet_tethering -->
  <remove-project name="platform/packages/apps/Settings" />
  <project path="packages/apps/Settings" name="android_packages_apps_Settings" remote="radicales" revision="android-15.0" />
</manifest>
